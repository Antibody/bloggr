{
  "name": "bloggr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "example:setup": "node scripts/example.mjs",
    "example": "node scripts/example.mjs --start",
    "example:stop": "supabase stop",
    "test:integration": "playwright test --config=playwright.integration.config.ts"
  },
  "author": {
    "name": "Maxim Bespalov",
    "url": "https://github.com/Antibody/bloggr"
  },
  "license": "MIT",
  "keywords": [
    "blog engine",
    "CMS",
    "blog platform",
    "ejs"
  ],
  "description": "Bloggr: A modern, full-stack Next.js-based blogging platform",
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-bullet-list": "3.32.1",
    "@tiptap/extension-code": "3.32.1",
    "@tiptap/extension-code-block": "3.32.1",
    "@tiptap/extension-image": "3.32.1",
    "@tiptap/extension-link": "3.32.1",
    "@tiptap/extension-list-item": "3.32.1",
    "@tiptap/extension-ordered-list": "3.32.1",
    "@tiptap/extension-placeholder": "3.32.1",
    "@tiptap/extension-text-align": "3.32.1",
    "@tiptap/extension-underline": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@types/pg": "^8.11.11",
    "entities": "6.0.1",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "pg": "^8.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.6.2",
    "supabase": "^2.19.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
